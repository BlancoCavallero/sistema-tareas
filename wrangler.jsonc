{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sistema-tareas",
	"compatibility_date": "2025-07-18",
	"compatibility_flags": ["nodejs_als"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sistema-tareas",
			// TODO: replace with the provisioned database id before any remote
			// deploy: `wrangler d1 create sistema-tareas`, then paste the UUID.
			// Local dev and tests work with the placeholder.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
